      "parameters": {
        "jsCode": "return items.map(item => {\n  const rawOutput = item.json.output;\n\n  // Limpiamos el string\n  let cleaned = rawOutput.replace(/```json|```/g, '').trim();\n\n  // Intentamos parsear, pero si falla, tratamos de arreglar puntaje_general textual\n  let parsed;\n  try {\n    parsed = JSON.parse(cleaned);\n  } catch (error) {\n    // 🔧 Fix rápido: intentar reemplazar puntaje_general textual por null\n    cleaned = cleaned.replace(/\"puntaje_general\"\\s*:\\s*([a-zA-Z]+)/, '\"puntaje_general\": null');\n    try {\n      parsed = JSON.parse(cleaned);\n    } catch (error2) {\n      throw new Error(\"No se pudo parsear el JSON, incluso después de limpiar: \" + error2.message + \"\\nContenido:\\n\" + cleaned);\n    }\n  }\n\n  // Si puntaje_general es string tipo \"fifty\" podemos intentar convertirlo a número\n  if (parsed.puntaje_general && typeof parsed.puntaje_general === 'string') {\n    const maybeNumber = parseInt(parsed.puntaje_general, 10);\n    if (!isNaN(maybeNumber)) {\n      parsed.puntaje_general = maybeNumber;\n    }\n  }\n\n  return { json: parsed };\n});\n"
      },
