    {
      "parameters": {
        "content": "## Dashboard para visualizar CVs\nAccede en:https://n8n.calzalindo.com.ar/webhook/cv\n\nDASHBOARD\nhttps://n8n.calzalindo.com.ar/webhook/dashboard",
