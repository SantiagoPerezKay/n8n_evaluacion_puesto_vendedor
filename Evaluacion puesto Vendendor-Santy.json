      "name": "Sticky Note Dashboard"
    },
    {
      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dashboard Evaluaciones - Calzalindo</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            padding: 20px;\n            min-height: 100vh;\n        }\n\n        .container {\n            max-width: 1400px;\n            margin: 0 auto;\n        }\n\n        .header {\n            background: white;\n            padding: 30px;\n            border-radius: 15px;\n            box-shadow: 0 10px 30px rgba(0,0,0,0.2);\n            margin-bottom: 30px;\n        }\n\n        h1 {\n            color: #333;\n            font-size: 2.5em;\n            margin-bottom: 10px;\n        }\n\n        .subtitle {\n            color: #666;\n            font-size: 1.1em;\n        }\n\n        .filters {\n            background: white;\n            padding: 25px;\n            border-radius: 15px;\n            box-shadow: 0 10px 30px rgba(0,0,0,0.2);\n            margin-bottom: 30px;\n            display: flex;\n            gap: 20px;\n            flex-wrap: wrap;\n            align-items: center;\n        }\n\n        .filter-group {\n            flex: 1;\n            min-width: 200px;\n        }\n\n        .filter-group label {\n            display: block;\n            margin-bottom: 8px;\n            color: #333;\n            font-weight: 600;\n        }\n\n        .filter-group input, .filter-group select {\n            width: 100%;\n            padding: 12px;\n            border: 2px solid #e0e0e0;\n            border-radius: 8px;\n            font-size: 1em;\n            transition: all 0.3s;\n        }\n\n        .filter-group input:focus, .filter-group select:focus {\n            outline: none;\n            border-color: #667eea;\n        }\n\n        .btn {\n            padding: 12px 30px;\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            color: white;\n            border: none;\n            border-radius: 8px;\n            cursor: pointer;\n            font-size: 1em;\n            font-weight: 600;\n            transition: transform 0.2s;\n            align-self: flex-end;\n        }\n\n        .btn:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);\n        }\n\n        .stats {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: 20px;\n            margin-bottom: 30px;\n        }\n\n        .stat-card {\n            background: white;\n            padding: 25px;\n            border-radius: 15px;\n            box-shadow: 0 10px 30px rgba(0,0,0,0.2);\n            text-align: center;\n        }\n\n        .stat-value {\n            font-size: 3em;\n            font-weight: bold;\n            color: #667eea;\n            margin: 10px 0;\n        }\n\n        .stat-label {\n            color: #666;\n            font-size: 1.1em;\n        }\n\n        .evaluaciones-grid {\n            display: grid;\n            gap: 20px;\n        }\n\n        .evaluacion-card {\n            background: white;\n            padding: 25px;\n            border-radius: 15px;\n            box-shadow: 0 10px 30px rgba(0,0,0,0.2);\n            transition: transform 0.3s;\n        }\n\n        .evaluacion-card:hover {\n            transform: translateY(-5px);\n            box-shadow: 0 15px 40px rgba(0,0,0,0.3);\n        }\n\n        .card-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            margin-bottom: 20px;\n            padding-bottom: 15px;\n            border-bottom: 2px solid #f0f0f0;\n        }\n\n        .telefono {\n            font-size: 1.3em;\n            font-weight: bold;\n            color: #333;\n        }\n\n        .puntaje-badge {\n            padding: 10px 20px;\n            border-radius: 25px;\n            font-size: 1.2em;\n            font-weight: bold;\n            color: white;\n        }\n\n        .puntaje-alto { background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); }\n        .puntaje-medio { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); }\n        .puntaje-bajo { background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); }\n\n        .fecha {\n            color: #999;\n            font-size: 0.9em;\n            margin-bottom: 15px;\n        }\n\n        .pregunta-respuesta {\n            margin-bottom: 15px;\n            padding: 15px;\n            background: #f8f9fa;\n            border-radius: 8px;\n            border-left: 4px solid #667eea;\n        }\n\n        .pregunta-titulo {\n            font-weight: 600;\n            color: #333;\n            margin-bottom: 8px;\n            font-size: 1em;\n        }\n\n        .pregunta-texto {\n            color: #555;\n            font-style: italic;\n            margin-bottom: 10px;\n            padding: 8px;\n            background: #e8eaf6;\n            border-radius: 5px;\n            font-size: 0.95em;\n        }\n\n        .respuesta {\n            color: #555;\n            margin-bottom: 8px;\n        }\n\n        .analisis {\n            color: #666;\n            font-style: italic;\n            font-size: 0.9em;\n            padding: 8px;\n            background: white;\n            border-radius: 5px;\n            margin-top: 8px;\n        }\n\n        .no-data {\n            text-align: center;\n            padding: 60px;\n            background: white;\n            border-radius: 15px;\n            box-shadow: 0 10px 30px rgba(0,0,0,0.2);\n        }\n\n        .no-data-icon {\n            font-size: 4em;\n            margin-bottom: 20px;\n        }\n\n        @media (max-width: 768px) {\n            .filters {\n                flex-direction: column;\n            }\n            \n            .filter-group {\n                width: 100%;\n            }\n\n            h1 {\n                font-size: 1.8em;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <div class=\"header\">\n            <h1>🏢 Dashboard Evaluaciones Calzalindo</h1>\n            <p class=\"subtitle\">Sistema de evaluación de candidatos</p>\n        </div>\n\n        <div class=\"filters\">\n            <div class=\"filter-group\">\n                <label for=\"filterNombre\">👤 Buscar por Nombre</label>\n                <input type=\"text\" id=\"filterNombre\" placeholder=\"Ej: Juan Pérez\">\n            </div>\n            <div class=\"filter-group\">\n                <label for=\"filterTelefono\">🔍 Buscar por Teléfono</label>\n                <input type=\"text\" id=\"filterTelefono\" placeholder=\"Ej: 3462516760\">\n            </div>\n            <div class=\"filter-group\">\n                <label for=\"filterPuntajeMin\">📊 Puntaje Mínimo</label>\n                <input type=\"number\" id=\"filterPuntajeMin\" placeholder=\"Ej: 7.0\" step=\"0.1\" min=\"0\" max=\"10\">\n            </div>\n            <div class=\"filter-group\">\n                <label for=\"filterPuntajeMax\">📊 Puntaje Máximo</label>\n                <input type=\"number\" id=\"filterPuntajeMax\" placeholder=\"Ej: 10.0\" step=\"0.1\" min=\"0\" max=\"10\">\n            </div>\n            <button class=\"btn\" onclick=\"aplicarFiltros()\">Filtrar</button>\n            <button class=\"btn\" onclick=\"limpiarFiltros()\">Limpiar</button>\n        </div>\n\n        <div class=\"stats\">\n            <div class=\"stat-card\">\n                <div class=\"stat-label\">Total Evaluaciones</div>\n                <div class=\"stat-value\" id=\"totalEvaluaciones\">0</div>\n            </div>\n            <div class=\"stat-card\">\n                <div class=\"stat-label\">Puntaje Promedio</div>\n                <div class=\"stat-value\" id=\"promedioScore\">0</div>\n            </div>\n            <div class=\"stat-card\">\n                <div class=\"stat-label\">Mejor Puntaje</div>\n                <div class=\"stat-value\" id=\"mejorScore\">0</div>\n            </div>\n            <div class=\"stat-card\">\n                <div class=\"stat-label\">Candidatos Filtrados</div>\n                <div class=\"stat-value\" id=\"totalFiltrados\">0</div>\n            </div>\n        </div>\n\n        <div id=\"evaluacionesContainer\" class=\"evaluaciones-grid\"></div>\n    </div>\n\n    <script>\n        // Recibe los datos desde n8n (del nodo Execute a SQL query1)\n        const datosN8n = {{ JSON.stringify($('traerdatosbd').all()) }};\n        \n        // Procesa los datos\n        let evaluacionesData = datosN8n.map(item => item.json);\n\n        // Función para cargar y mostrar datos\n        function inicializarDashboard() {\n            if (evaluacionesData && evaluacionesData.length > 0) {\n                mostrarEvaluaciones(evaluacionesData);\n                actualizarEstadisticas(evaluacionesData);\n            } else {\n                document.getElementById('evaluacionesContainer').innerHTML = `\n                    <div class=\"no-data\">\n                        <div class=\"no-data-icon\">📋</div>\n                        <h2>No se encontraron evaluaciones</h2>\n                        <p>No hay datos disponibles en la base de datos</p>\n                    </div>\n                `;\n            }\n        }\n\n        function mostrarEvaluaciones(data) {\n            const container = document.getElementById('evaluacionesContainer');\n            \n            if (data.length === 0) {\n                container.innerHTML = `\n                    <div class=\"no-data\">\n                        <div class=\"no-data-icon\">📋</div>\n                        <h2>No se encontraron evaluaciones</h2>\n                        <p>Intenta ajustar los filtros</p>\n                    </div>\n                `;\n                return;\n            }\n\n            container.innerHTML = data.map(evaluacion => {\n                const puntajeClass = evaluacion.puntaje >= 8 ? 'puntaje-alto' : \n                                    evaluacion.puntaje >= 6 ? 'puntaje-medio' : 'puntaje-bajo';\n                \n                const fecha = new Date(evaluacion.created_at).toLocaleString('es-AR');\n\n                return `\n                    <div class=\"evaluacion-card\">\n                        <div class=\"card-header\">\n                            <span class=\"telefono\">📱 ${evaluacion.telefono || 'Sin teléfono'}</span>\n                            <span class=\"puntaje-badge ${puntajeClass}\">${evaluacion.puntaje ? evaluacion.puntaje.toFixed(1) : 'N/A'}</span>\n                        </div>\n                        <div class=\"fecha\">📅 ${fecha}</div>\n                        ${evaluacion.nombre ? `<div class=\"fecha\">👤 ${evaluacion.nombre}</div>` : ''}\n                        \n                        ${[1,2,3,4,5,6].map(num => {\n                            if (!evaluacion[`respuesta${num}`]) return '';\n                            return `\n                                <div class=\"pregunta-respuesta\">\n                                    <div class=\"pregunta-titulo\">❓ Pregunta ${num}</div>\n                                    ${evaluacion[`pregunta${num}`] ? `<div class=\"pregunta-texto\">${evaluacion[`pregunta${num}`]}</div>` : ''}\n                                    <div class=\"respuesta\"><strong>✍️ Respuesta:</strong> ${evaluacion[`respuesta${num}`]}</div>\n                                    ${evaluacion[`analisis${num}`] ? `<div class=\"analisis\">💡 <strong>Análisis:</strong> ${evaluacion[`analisis${num}`]}</div>` : ''}\n                                </div>\n                            `;\n                        }).join('')}\n                    </div>\n                `;\n            }).join('');\n        }\n\n        function actualizarEstadisticas(data) {\n            const total = data.length;\n            const puntajes = data.filter(e => e.puntaje).map(e => e.puntaje);\n            const promedio = puntajes.length > 0 ? \n                (puntajes.reduce((a, b) => a + b, 0) / puntajes.length).toFixed(1) : 0;\n            const mejor = puntajes.length > 0 ? Math.max(...puntajes).toFixed(1) : 0;\n\n            document.getElementById('totalEvaluaciones').textContent = evaluacionesData.length;\n            document.getElementById('promedioScore').textContent = promedio;\n            document.getElementById('mejorScore').textContent = mejor;\n            document.getElementById('totalFiltrados').textContent = total;\n        }\n\n        function aplicarFiltros() {\n            const nombre = document.getElementById('filterNombre').value.trim().toLowerCase();\n            const telefono = document.getElementById('filterTelefono').value.trim();\n            const puntajeMin = parseFloat(document.getElementById('filterPuntajeMin').value) || 0;\n            const puntajeMax = parseFloat(document.getElementById('filterPuntajeMax').value) || 10;\n\n            let filtrados = evaluacionesData.filter(evaluacion => {\n                const matchNombre = !nombre || (evaluacion.nombre && evaluacion.nombre.toLowerCase().includes(nombre));\n                const matchTelefono = !telefono || (evaluacion.telefono && evaluacion.telefono.includes(telefono));\n                const matchPuntaje = !evaluacion.puntaje || \n                    (evaluacion.puntaje >= puntajeMin && evaluacion.puntaje <= puntajeMax);\n                \n                return matchNombre && matchTelefono && matchPuntaje;\n            });\n\n            mostrarEvaluaciones(filtrados);\n            actualizarEstadisticas(filtrados);\n        }\n\n        function limpiarFiltros() {\n            document.getElementById('filterNombre').value = '';\n            document.getElementById('filterTelefono').value = '';\n            document.getElementById('filterPuntajeMin').value = '';\n            document.getElementById('filterPuntajeMax').value = '';\n            mostrarEvaluaciones(evaluacionesData);\n            actualizarEstadisticas(evaluacionesData);\n        }\n\n        // Inicializar el dashboard al cargar\n        inicializarDashboard();\n    </script>\n</body>\n</html>"
      },
